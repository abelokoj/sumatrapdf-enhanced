 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "FileDescription", kAppDisplayName
            VALUE "FileVersion", ENHANCED_VERSION_STRA
            VALUE "LegalCopyright", kCopyrightStr
            VALUE "ProductName", kAppDisplayName
            VALUE "ProductVersion", ENHANCED_VERSION_STRA
            VALUE "CompanyName", kPublisherStr
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

/////////////////////////////////////////////////////////////////////////////

// One LzSA archive with all embedded files (see resource.h), packed by the
// prebuild (cmd\pack-embedded-prebuild.cmd) into out\<cfg>\ and passed in via
// the EMBEDDED_PAK resdefine (premake5.lua): embedded-static.lzsa for the
// static build, embedded.lzsa (also holding libsumatrapdf.dll & co) for the
// dll/installer build. PdfPreview.dll & co read it from SumatraPDF.exe next to
// them (src/EmbeddedResources.cpp), so the fonts\* entries serve them too.
#ifndef EMBEDDED_PAK
#error EMBEDDED_PAK not defined (path of the out\<cfg>\embedded*.lzsa archive)
#endif
IDR_EMBEDDED_PAK        RCDATA               QM(EMBEDDED_PAK)

// Bundled UI faces are loaded privately with AddFontMemResourceEx.
ENHANCED_FONT_MANROPE_REGULAR RCDATA "fonts\\Manrope-Regular.otf"
