VS_VERSION_INFO VERSIONINFO
 FILEVERSION ENHANCED_VERSION_RESOURCE
 PRODUCTVERSION ENHANCED_VERSION_RESOURCE
 FILEFLAGSMASK 0x0L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
